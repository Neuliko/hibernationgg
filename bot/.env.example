# Discord bot — required
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_application_id

# Optional: register slash commands to a single guild for instant updates during dev
GUILD_ID=

# Lovable Cloud — copy from your project's .env (Lovable Cloud dashboard)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your_service_role_key...

# Inactivity scan interval (ms). Default 60000 (every minute).
SCAN_INTERVAL_MS=60000
