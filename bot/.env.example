# Discord Bot
DISCORD_TOKEN=your_bot_token_here
GUILD_ID=optional_single_guild_id

# Command Prefix (for text-based commands like !hibernate, !link)
COMMAND_PREFIX=!

# Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Scan interval for hibernation checks (milliseconds, default: 60000)
SCAN_INTERVAL_MS=60000
